# このファイルを `.env.local` にコピーして値を埋めてください(.env.local は gitignore 済み)。
#   cp .env.local.example .env.local
# `pnpm tauri:build` 実行時に読み込まれ、コード署名・公証に使われます。

# コード署名(Developer ID Application)
APPLE_SIGNING_IDENTITY="Developer ID Application: John Doe (TEAM_ID)"

# 公証(notarization)
APPLE_ID="you@example.com"
APPLE_PASSWORD="xxxx-xxxx-xxxx-xxxx"   # App 用パスワード(通常のログインパスワード不可)
APPLE_TEAM_ID="TEAM_ID"
